    Stock aapl("AAPL");
    aapl.addReturn(0.012);
    aapl.addReturn(-0.003);
    aapl.addReturn(0.008);
    aapl.addReturn(0.001);
    aapl.addReturn(-0.005);

    Stock msft("MSFT");
    msft.addReturn(0.009);
    msft.addReturn(0.004);
    msft.addReturn(-0.002);
    msft.addReturn(0.007);
    msft.addReturn(0.003);

    Stock googl("GOOGL");
    googl.addReturn(0.005);
    googl.addReturn(-0.001);
    googl.addReturn(0.006);
    googl.addReturn(-0.004);
    googl.addReturn(0.002);

    Bond treasury("10Y Treasury", 3.5, 1000);
    treasury.addReturn(0.002);
    treasury.addReturn(0.0015);
    treasury.addReturn(0.001);
    treasury.addReturn(0.0005);
    treasury.addReturn(0.001);

    cout << "=== Individual Asset Statistics ===" << endl;
    aapl.printStats();
    msft.printStats();
    googl.printStats();
    treasury.printStats();

    Portfolio stockPortfolio;
    stockPortfolio.addAsset(&aapl, 1.0/3.0);
    stockPortfolio.addAsset(&msft, 1.0/3.0);
    stockPortfolio.addAsset(&googl, 1.0/3.0);
    stockPortfolio.printSummary();

    Portfolio mixedPortfolio;
    mixedPortfolio.addAsset(&aapl, 0.4);
    mixedPortfolio.addAsset(&msft, 0.3);
    mixedPortfolio.addAsset(&treasury, 0.3);
    mixedPortfolio.printSummary();

    Portfolio twoAssetPort;
    twoAssetPort.addAsset(&aapl, 0.5);
    twoAssetPort.addAsset(&msft, 0.5);
    twoAssetPort.findOptimalPortfolio(0.02);

    return 0;
}
